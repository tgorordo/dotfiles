#!/usr/bin/env bash

export PASSWORD_STORE_DIR="$HOME/.config/protonmail/password-store"
unset GNUPGHOME
export PINENTRY_USER_DATA=gtk

BRIDGE_BIN="protonmail-bridge"
BRIDGE_MATCH="protonmail-bridge"

IMAP_HOST="127.0.0.1"
IMAP_PORT="1143"
READY_TIMEOUT=30

started_bridge=0
if ! pgrep -f "$BRIDGE_MATCH" >/dev/null 2>&1; then
    "$BRIDGE_BIN" --noninteractive >/dev/null 2>&1 &
    started_bridge=1
fi

ready=0
for ((i=0; i<READY_TIMEOUT; i++)); do
    if (exec 3<>"/dev/tcp/$IMAP_HOST/$IMAP_PORT") 2>/dev/null; then
        exec 3>&-; ready=1; break
    fi
    sleep 1
done
[[ $ready -eq 1 ]] || echo "thunderbird-bridge: Bridge IMAP not up after ${READY_TIMEOUT}s; launching Thunderbird anyway" >&2

thunderbird "$@" #--no-remote

if [[ $started_bridge -eq 1 ]]; then
    pkill -f "$BRIDGE_MATCH"
fi
